# ==============================================================================
# Client Environment Variables (.env)
# Set in project root for Vite build
# ==============================================================================
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional Developer Simulator (strictly active only in local dev when Supabase is unconfigured)
VITE_ALLOW_DEV_SIMULATOR=false

# ==============================================================================
# Supabase Edge Function Secrets
# Set via Supabase CLI or Dashboard: supabase secrets set KEY=VALUE
# ==============================================================================
# TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_private_key
# PAYOUT_WEBHOOK_SECRET=optional_gateway_webhook_hmac_secret
